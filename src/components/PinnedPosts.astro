---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getPostUrlBySlug } from "@utils/url-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";

interface Props {
    posts: CollectionEntry<"posts">[];
    class?: string;
    style?: string;
}
const { posts, style } = Astro.props;
const className = Astro.props.class;
---
<div class:list={["card-base px-6 md:px-8 py-6 mb-4 onload-animation", className]} style={style}>
    <div class="flex items-center gap-2 font-bold text-lg text-neutral-900 dark:text-neutral-100 mb-3">
        <Icon name="material-symbols:star-rounded" class="text-[1.4rem] text-[var(--primary)]" />
        精选文章
    </div>
    <div class="flex flex-col">
        {posts.map((post) => (
            <a href={getPostUrlBySlug(post.slug)}
                class="group flex flex-col py-2 border-b-[1px] border-dashed border-[var(--line-divider)] last:border-0
                       transition hover:bg-black/[0.03] dark:hover:bg-white/[0.03] rounded-lg px-2 -mx-2">
                <div class="flex items-baseline justify-between gap-3">
                    <span class="transition font-bold text-black/80 dark:text-white/80
                                 group-hover:text-[var(--primary)]">
                        {post.data.title}
                    </span>
                    <span class="text-sm text-black/35 dark:text-white/35 whitespace-nowrap"
                          data-pagefind-ignore>
                        {formatDateToYYYYMMDD(new Date(post.data.published))}
                    </span>
                </div>
                {post.data.description && (
                    <span class="text-sm text-black/50 dark:text-white/50 transition
                                 group-hover:translate-x-0.5 line-clamp-2">
                        {post.data.description}
                    </span>
                )}
            </a>
        ))}
    </div>
</div>
