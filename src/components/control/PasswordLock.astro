---
import { Icon } from "astro-icon/components";

interface Props {
	hash: string;
	hint?: string;
}

const { hash, hint = "此文章受密码保护，请输入密码解锁" } = Astro.props;
---

<div id="private-lock-container" data-hash={hash} class="w-full">
    <!-- 锁定状态下的门禁卡片 -->
    <div id="lock-card" class="card-base p-8 my-6 flex flex-col items-center text-center max-w-md mx-auto border border-black/10 dark:border-white/10 shadow-lg">
        <div class="w-16 h-16 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] flex items-center justify-center mb-4">
            <Icon name="material-symbols:lock-outline" class="text-3xl" />
        </div>
        <h3 class="text-xl font-bold text-black/90 dark:text-white/90 mb-2">私密对话专区</h3>
        <p class="text-sm text-black/60 dark:text-white/60 mb-6 px-4">{hint}</p>

        <form id="lock-form" class="w-full flex flex-col gap-3">
            <div class="relative w-full">
                <input
                    type="password"
                    id="lock-input"
                    placeholder="请输入访问密码..."
                    autocomplete="current-password"
                    class="w-full px-4 py-2.5 rounded-lg border border-black/15 dark:border-white/15 bg-black/5 dark:bg-white/5 text-black/90 dark:text-white/90 focus:outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/20 transition text-sm"
                />
            </div>
            <div class="flex items-center justify-between text-xs text-black/60 dark:text-white/60 px-1">
                <label class="flex items-center gap-1.5 cursor-pointer select-none">
                    <input type="checkbox" id="lock-remember" checked class="rounded accent-[var(--primary)] cursor-pointer" />
                    <span>在此设备上记住密码</span>
                </label>
                <span id="lock-error" class="text-red-500 font-medium hidden">密码错误，请重试</span>
            </div>
            <button
                type="submit"
                id="lock-btn"
                class="w-full py-2.5 mt-2 rounded-lg bg-[var(--primary)] text-white font-medium text-sm hover:opacity-90 active:scale-[0.98] transition flex items-center justify-center gap-2 cursor-pointer shadow-sm"
            >
                <Icon name="material-symbols:key-outline" class="text-lg" />
                解锁正文
            </button>
        </form>
    </div>

    <!-- 解锁后的正文插槽 -->
    <div id="unlocked-content" class="hidden transition-opacity duration-300">
        <slot />
        <div class="mt-8 pt-4 border-t border-dashed border-[var(--line-divider)] flex justify-end">
            <button type="button" id="relock-btn" class="text-xs text-black/40 dark:text-white/40 hover:text-[var(--primary)] transition flex items-center gap-1 cursor-pointer">
                <Icon name="material-symbols:lock-reset" class="text-sm" />
                重新锁定
            </button>
        </div>
    </div>
</div>

<script>
    async function sha256Hex(str: string): Promise<string> {
        const buffer = new TextEncoder().encode(str);
        const hashBuffer = await crypto.subtle.digest("SHA-256", buffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, "0")).join("");
    }

    function initPasswordLock() {
        const container = document.getElementById("private-lock-container");
        if (!container) return;

        const targetHash = container.getAttribute("data-hash") || "";
        const lockCard = document.getElementById("lock-card");
        const unlockedContent = document.getElementById("unlocked-content");
        const lockForm = document.getElementById("lock-form") as HTMLFormElement | null;
        const lockInput = document.getElementById("lock-input") as HTMLInputElement | null;
        const lockRemember = document.getElementById("lock-remember") as HTMLInputElement | null;
        const lockError = document.getElementById("lock-error");
        const relockBtn = document.getElementById("relock-btn");

        const STORAGE_KEY = "boke_private_lock_token";

        function unlock() {
            if (lockCard) lockCard.classList.add("hidden");
            if (unlockedContent) {
                unlockedContent.classList.remove("hidden");
                unlockedContent.classList.add("opacity-100");
            }
        }

        function lock() {
            if (lockCard) lockCard.classList.remove("hidden");
            if (unlockedContent) {
                unlockedContent.classList.add("hidden");
                unlockedContent.classList.remove("opacity-100");
            }
            if (lockInput) {
                lockInput.value = "";
                lockInput.focus();
            }
            if (lockError) lockError.classList.add("hidden");
            try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
        }

        // 检查之前是否已经记住密码
        try {
            const savedHash = localStorage.getItem(STORAGE_KEY);
            if (savedHash && savedHash === targetHash) {
                unlock();
                return;
            }
        } catch (e) {}

        if (lockForm) {
            lockForm.onsubmit = async (e) => {
                e.preventDefault();
                const pwd = lockInput ? lockInput.value.trim() : "";
                if (!pwd) return;

                const inputHash = await sha256Hex(pwd);
                if (inputHash === targetHash) {
                    if (lockRemember && lockRemember.checked) {
                        try { localStorage.setItem(STORAGE_KEY, inputHash); } catch (e) {}
                    }
                    unlock();
                } else {
                    if (lockError) lockError.classList.remove("hidden");
                    if (lockInput) {
                        lockInput.classList.add("border-red-500");
                        setTimeout(() => lockInput.classList.remove("border-red-500"), 1500);
                        lockInput.select();
                    }
                }
            };
        }

        if (relockBtn) {
            relockBtn.onclick = () => {
                lock();
            };
        }
    }

    // 初始加载与 Swup 切页兼容
    initPasswordLock();
    document.addEventListener("DOMContentLoaded", initPasswordLock);
    if ((window as any).swup) {
        (window as any).swup.hooks?.on("page:view", initPasswordLock);
    }
</script>
