---
import { getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";

export async function getStaticPaths() {
	// 草稿不构建：不会出现在站点、RSS、sitemap 与 Pagefind 索引中
	const papers = await getCollection("papers", ({ data }) => data.draft !== true);
	return papers.map((paper) => ({
		params: { slug: paper.id },
		props: { paper },
	}));
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const pd = paper.data;

// 相关推荐：同主题论文 + 同标签博客文章
const allPapers = await getCollection("papers", ({ data }) => data.draft !== true);
const relatedPapers = allPapers
	.filter((p) => p.id !== paper.id && p.data.topics?.some((t) => pd.topics?.includes(t)))
	.slice(0, 3);
const allPosts = await getCollection("posts", ({ data }) => data.draft !== true);
const relatedPosts = allPosts
	.filter((p) => p.data.tags?.some((t) => pd.tags?.includes(t)))
	.slice(0, 3);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "ScholarlyArticle",
	headline: pd.title,
	description: pd.description,
	author: { "@type": "Person", name: profileConfig.name, url: Astro.site },
	inLanguage: "zh-CN",
};
---

<MainGridLayout banner={undefined} title={pd.title} description={pd.description} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} slot="head" />
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-6 relative w-full">
            <div class="onload-animation">
                <div data-pagefind-body data-pagefind-weight="10"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem] relative">
                    {pd.title}
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-black/50 dark:text-white/50 mb-3">
                    {pd.year && <span>{pd.year}</span>}
                    {pd.venue && <span>{pd.venue}</span>}
                    {pd.doi && <span>DOI: {pd.doi}</span>}
                    {pd.arxiv && <span>arXiv: {pd.arxiv}</span>}
                    {pd.updated && <span>笔记更新：{pd.updated}</span>}
                </div>
                <div class="flex flex-wrap gap-2 mb-4">
                    {pd.paperUrl && (
                        <a href={pd.paperUrl} target="_blank" rel="noopener"
                            class="btn-card !py-1.5 !px-3 text-sm flex items-center gap-1.5">
                            <Icon name="fa6-solid:file-lines" class="text-sm" /> 论文原文
                        </a>
                    )}
                    {pd.arxiv && (
                        <a href={'https://arxiv.org/abs/' + pd.arxiv} target="_blank" rel="noopener"
                            class="btn-card !py-1.5 !px-3 text-sm flex items-center gap-1.5">
                            <Icon name="fa6-solid:arrow-up-right-from-square" class="text-sm" /> arXiv
                        </a>
                    )}
                    {pd.githubUrl && (
                        <a href={pd.githubUrl} target="_blank" rel="noopener"
                            class="btn-card !py-1.5 !px-3 text-sm flex items-center gap-1.5">
                            <Icon name="fa6-brands:github" class="text-sm" /> 代码仓库
                        </a>
                    )}
                    {pd.topics.map((t) => (
                        <span class="rounded-md bg-[var(--primary)]/10 text-[var(--primary)] px-2 py-1 text-sm">{t}</span>
                    ))}
                </div>
                {pd.description && (
                    <p class="text-black/60 dark:text-white/60 mb-4 border-l-2 border-[var(--primary)] pl-3">
                        {pd.description}
                    </p>
                )}
                <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-4"></div>
            </div>

            <div data-pagefind-body class="onload-animation">
                <Markdown class="mb-6 markdown-content">
                    <Content />
                </Markdown>
            </div>

            {(relatedPapers.length > 0 || relatedPosts.length > 0) && (
                <div class="border-t-[1px] border-dashed border-[var(--line-divider)] pt-4 mt-2">
                    <h2 class="text-xl font-bold text-black/90 dark:text-white/90 mb-3 flex items-center gap-2">
                        <Icon name="material-symbols:library-books-outline-rounded"
                            class="text-[1.25rem] text-[var(--primary)]" />
                        相关阅读
                    </h2>
                    <div class="flex flex-col gap-2">
                        {relatedPapers.map((p) => (
                            <a href={'/papers/' + p.id + '/'}
                                class="transition text-black/70 dark:text-white/70 hover:text-[var(--primary)] text-sm">
                                [论文] {p.data.title}
                            </a>
                        ))}
                        {relatedPosts.map((p) => (
                            <a href={'/posts/' + p.slug + '/'}
                                class="transition text-black/70 dark:text-white/70 hover:text-[var(--primary)] text-sm">
                                [文章] {p.data.title}
                            </a>
                        ))}
                    </div>
                </div>
            )}
        </div>
    </div>
</MainGridLayout>
